<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lab2.Pages.MainPage"
             Title="About Me">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="img1.jpg" 
                   Aspect="AspectFill"
                   HeightRequest="200"
                   WidthRequest="250"
                   HorizontalOptions="Center" 
                   SemanticProperties.Description="Ninja Photo"/>
            <Label Text="Andrii Ostapenko"
                   FontSize="24"
                   HorizontalOptions="Center" 
                   TextColor="Black"/>
            <Label Text="Group: 151 Year: 2025"
                   FontSize="18"
                   HorizontalOptions="Center"/>
            <Label Text="Hometown: Odesa"
                   FontSize="18"
                   HorizontalOptions="Center"/>
            <Label x:Name="DescriptionLabel"
                   FontSize="18"
                   HorizontalOptions="Center"/>
            <Button Text="Show description and hobby"
                    Clicked="OnChangeTextClicked"
                    HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
